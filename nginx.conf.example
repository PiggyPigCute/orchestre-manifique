# orchestre-manifique.chruk.fr
#   /          -> site statique (orma/site)
#   /photos/   -> drive photo (orma/photos, node sur le port 3010)
server {
    server_name orchestre-manifique.chruk.fr;

    root /CHEMIN/VERS/orma/site;
    index index.html;

    # les photos font souvent plusieurs Mo : rester au-dessus de la limite du serveur (40 Mo)
    client_max_body_size 45M;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /photos {
        return 301 /photos/;
    }

    # le "/" final de proxy_pass retire le préfixe /photos avant d'arriver au serveur node
    location /photos/ {
        proxy_pass http://127.0.0.1:3010/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }

    # + les lignes listen 443 / ssl_certificate ajoutées par certbot
}
